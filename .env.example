# PM Cosmetics Hub runtime
NODE_ENV=production
PORT=8080

# Commercial publication stays CLOSED until product evidence is verified
COMMERCIAL_PUBLISH_GATE=CLOSED

# WooCommerce REST API
WOOCOMMERCE_URL=https://your-store.example
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_SYNC_ENABLED=false
WOOCOMMERCE_BATCH_SIZE=50

# Manus catalog adapter
# Set this to a Manus-export/API endpoint that returns a JSON array or {"products":[...]}.
MANUS_PRODUCTS_URL=
MANUS_API_TOKEN=
MANUS_SYNC_ENABLED=false
MANUS_MAX_PRODUCTS=10000

# Never commit real credentials to Git.
